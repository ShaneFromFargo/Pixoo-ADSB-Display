{
  "Flags": {
    "ExecutionLoop": 30, //The number of seconds between each execution of the loop. If using your own ADSB receiver you can set this to 1, but if you're using the API you'll burn your credits up quick, 275 allows you to use the $10 tier all month.
    "LogFilePath": "", //Leave blank to use the default log file path. If you want to use your own path, enter it here.
    "FeederSource": "Local", //Options are Local or API. If you're using your own ADSB receiver, use Local. If you're using the API, use API.
    "LocalFeederIp": "http://adsbexchange.local", //The IP address of your ADSB receiver. Only used if FeederSource is set to Local.
    "Latitude": 32.776665, //Latitude of your location
    "Longitude": -96.796989, //Longitude of your location
    "Radius": 5,
    "HomeAirports": [
      "DAL",
      "DFW"
    ], //Radius in miles of the area you want to monitor
    "RapidAPIKey": "XXXXXXXXXXX" //Your RapidAPI key. Get one here: https://rapidapi.com/adsbx/api/adsbexchange-com1
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
